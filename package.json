{
  "name": "parte",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:gemini:live": "bun scripts/gemini-live-check.ts",
    "test:watch": "jest --watch",
    "export:ios": "expo export --platform ios",
    "eas:init": "eas init",
    "build:dev:ios": "eas build -p ios --profile development",
    "build:dev:android": "eas build -p android --profile development",
    "testflight:dev": "eas build -p ios --profile testflight --submit"
  },
  "dependencies": {
    "@expo/ui": "57.0.13",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-native-picker/picker": "2.11.4",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "2.112.3",
    "expo": "~57.0.16",
    "expo-blur": "^57.0.2",
    "expo-constants": "~57.0.14",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.15",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linear-gradient": "^57.0.1",
    "expo-linking": "~57.0.7",
    "expo-location": "~57.0.13",
    "expo-media-library": "~57.0.4",
    "expo-notifications": "~57.0.14",
    "expo-router": "~57.0.16",
    "expo-secure-store": "~57.0.1",
    "expo-speech-recognition": "^56.0.1",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-nano-icons": "^0.2.1",
    "react-native-reanimated": "~4.5.0",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "2.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "~0.10.0",
    "zod": "4.1.12",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "9.39.1",
    "eslint-config-expo": "~57.0.1",
    "jest": "29.7.0",
    "jest-expo": "~57.0.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-native-screens": "4.26.2"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/tests/**/*.test.(ts|tsx)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.ts"
    ]
  }
}
