EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<supabase-anon-or-publishable-key>

# SMTP / Auth email (production or staging)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=<smtp-or-provider-password>
# SMTP_ADMIN_EMAIL=admin@example.com
# SMTP_SENDER_NAME="Horas"

# Configure only as a Supabase Edge Function secret. Never prefix it EXPO_PUBLIC_.
# GEMINI_API_KEY=your-server-secret
